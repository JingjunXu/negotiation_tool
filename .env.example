OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE_RESPONSES=false
RUN_LIVE_OPENAI_TESTS=false
APP_DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
LOG_LEVEL=INFO

# --- Not part of the fixed SPEC stack; opt-in local alternative only. ---
# AI_PROVIDER=claude_cli   # uncomment to use the local `claude` CLI instead of OpenAI
# CLAUDE_CLI_PATH=         # override auto-detected `claude` executable path
# CLAUDE_CLI_MODEL=        # e.g. claude-sonnet-5; leave unset to use claude's own default
# CLAUDE_CLI_TIMEOUT_S=300
